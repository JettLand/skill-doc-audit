#!/bin/sh
# pre-push hook: 发布前本地门禁。
#   推送到 main 前，自动跑：
#     ① dev_self_audit.py --strict        （发布质量 + 部署副本同步门禁）
#     ② self_validate.py                  （检查器行为回归）
#   任一失败 → 拦截本次 push，逼你在发布前修复。
# 与 post-commit 同目录；由 core.hooksPath 绝对路径安装，git 推 main 时自动触发。
set -e 2>/dev/null || true

# `|| true` 不可省（同 post-commit）：开了 set -e 时，git 不可用会让命令替换非 0 并
# errexit 终止，导致告警都打印不出来 —— 静默跳过是要避免的失效模式。
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-push] 无法解析仓库根，跳过门禁"
  exit 0
fi

# 仅对推送到 main 分支执行门禁（其他分支推送不拦截）
RUN=0
while read -r lref lsha rref rsha; do
  case "$rref" in
    refs/heads/main) RUN=1 ;;
  esac
done
if [ "$RUN" -eq 0 ]; then
  exit 0
fi

# 守卫：src/ 或文档有未提交改动 → 先 commit 再 push。
# 既避免推送不完整，也间接保证部署副本与源码同步（提交即被 post-commit 钩子同步）。
if ! git diff --quiet HEAD -- src/ README.md CHANGELOG.md DEVELOPMENT.md 2>/dev/null; then
  echo "[pre-push] 发现 src/ 或文档有未提交改动，请先 commit 再 push："
  git status --short -- src/ README.md CHANGELOG.md DEVELOPMENT.md
  exit 1
fi

# python 候选（同 post-commit：git 子进程不继承交互 PATH，须绝对路径优先）
# 解耦（跨平台 / 跨机器）：以 $HOME 与系统标准路径表达，绝不写死某用户绝对路径。
#   SKILL_AUDIT_PYTHON（最高优先）/ SKILL_AUDIT_PYTHON_CANDIDATES（空格分隔追加）
PY=""
if [ -n "$SKILL_AUDIT_PYTHON" ] && [ -x "$SKILL_AUDIT_PYTHON" ]; then
  PY="$SKILL_AUDIT_PYTHON"
else
  for cand in \
    $SKILL_AUDIT_PYTHON_CANDIDATES \
    "$HOME/.workbuddy/binaries/python/versions/3.13.12/python.exe" \
    "$HOME/.workbuddy/binaries/python/versions/3.13.12/python" \
    "$HOME/.workbuddy/binaries/python/versions/3.13.12.old.8740/python.exe" \
    "/usr/bin/python3" \
    "/usr/local/bin/python3" \
    "/opt/homebrew/bin/python3" ; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then PY="$cand"; break; fi
  done
fi
if [ -z "$PY" ]; then
  if command -v python3 >/dev/null 2>&1; then PY="python3"
  elif command -v python >/dev/null 2>&1; then PY="python"
  fi
fi
if [ -z "$PY" ]; then
  echo "[pre-push] 未找到 python（绝对候选 + PATH），跳过门禁。"
  echo "[pre-push] 请手动跑：dev_self_audit.py --strict 与 self_validate.py"
  exit 0
fi

# 审计报告落盘：供 agent 接手分析（不依赖谁执行 push，守住「push 手动」约定）。
# 生命周期由本钩子自管理（代码强制删除，不依赖 agent 记忆）：
#   - 每次运行开始时先 rm -f 上一轮报告 → 杜绝跨 push 残留；
#   - 文件位于 bench/（已 gitignore），即便意外残留也不进版本库；
#   - doc-llm dossier 写在系统临时目录，由 OS 清理。
# agent 只需在需要时读取，无需、也不应手动删除（删除由钩子负责）。
REPORT_DIR="$REPO_ROOT/bench"
REPORT="$REPORT_DIR/agent_audit_report.md"
rm -f "$REPORT" 2>/dev/null || true   # 自清理上一轮报告（代码强制，非约定）
mkdir -p "$REPORT_DIR" 2>/dev/null || true
ERR_TMP=$(mktemp 2>/dev/null || echo "$REPORT_DIR/.prepush_stderr")

echo "[pre-push] ① 开发模式自审计（发布质量 + 同步门禁）；报告落盘: $REPORT"
"$PY" "$REPO_ROOT/src/scripts/dev_self_audit.py" --strict > "$REPORT" 2> "$ERR_TMP" \
  || { echo "[pre-push] ✗ 自审计未通过，已拦截 push。报告: $REPORT（钩子下次运行自动清理，无需手动删）"; cat "$ERR_TMP"; exit 1; }

# doc-llm 语义漂移门禁（item 6/7 的「回传 agent 分析」通道）：
# dev_self_audit 以硬编码 agent 模式写 dossier，内含确定性的「正向覆盖缺口」段；
# 若该段列出缺口，说明代码有、文档未写，须 agent 接手判读后才可发布 → 拦 push。
# 设 SKILL_AUDIT_SKIP_DOC_LLM_GATE=1 可放行（agent 已确认缺口有意、非漏改）。
if [ -z "$SKILL_AUDIT_SKIP_DOC_LLM_GATE" ]; then
  DOSSIER=$(grep -o 'AGENT_TAKEOVER: .*' "$ERR_TMP" 2>/dev/null | sed 's/AGENT_TAKEOVER: //' | head -1)
  if [ -n "$DOSSIER" ] && [ -f "$DOSSIER" ]; then
    if grep -qE '检查器在代码注册但文档未提及|命令行参数在代码声明但文档未提及' "$DOSSIER"; then
      echo "[pre-push] ✗ doc-llm 检测到确定性「正向覆盖缺口」，已拦截 push（须 agent 接手判读）。"
      echo "[pre-push]   dossier: $DOSSIER"
      echo "[pre-push]   agent 读取 dossier 完成语义比对：补文档，或确认代码能力应保留；"
      echo "[pre-push]   处理后（补文档或确认缺口有意）再 push；dossier 在系统临时目录、报告下次 push 自动清理，均无需手动删除。"
      exit 1
    fi
  fi
else
  echo "[pre-push] ⚠ SKILL_AUDIT_SKIP_DOC_LLM_GATE 已设，跳过 doc-llm 缺口门禁。"
fi

echo "[pre-push] ② 示例回归自校验（检查器行为）"
"$PY" "$REPO_ROOT/src/scripts/self_validate.py" \
  || { echo "[pre-push] ✗ 自校验未通过，已拦截 push。若检查器有意变更，先跑 self_validate.py --baseline 再提交。"; exit 1; }

echo "[pre-push] ✓ 门禁全部通过，继续 push。"
echo "[pre-push] 审计报告已落盘: $REPORT（gitignored，下次 push 时钩子自动清理，无需手动删除）"
exit 0
